CLOUDFLARE_ACCOUNT_ID=xxx
CLOUDFLARE_API_TOKEN=xxx

# 写真の置き場（R2）。バケット名と、その公開 URL の先頭（カスタムドメイン）
HIBI_R2_BUCKET=hibi
HIBI_R2_URL=https://img.example.com
# content/ の写しを取るバケット。写真のバケットは公開されるので別にする
HIBI_R2_BACKUP_BUCKET=hibi-backup
# トークンを deploy 用と分けるとき（無ければ CLOUDFLARE_API_TOKEN を使う）
# HIBI_R2_TOKEN=xxx
